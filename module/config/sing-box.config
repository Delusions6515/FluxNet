# ============================================================
# FluxNet 模块配置
# 修改后重启服务生效
# ============================================================

# ---------- 路径 ----------
sing_box_path="/data/adb/fluxnet"

# ---------- 内核渠道 ----------
# delusions6515-pre / delusions6515-stable / ref1nd-pre / ref1nd-stable
# official-stable / official-pre
kernel_channel="delusions6515-pre"
kernel_abi="arm64-v8a"

# ---------- 代理模式 ----------
# tun / tproxy / redirect / ebpf
# tun stack: system / gvisor / mixed (仅 tun 模式生效)
# tun auto_redirect: 0=关闭, 1=开启 (仅 tun 模式生效)
# ebpf mode: local / shared (仅 ebpf 模式生效)
proxy_mode="tproxy"
tun_stack="gvisor"
auto_redirect=1
ebpf_mode="local"

# ---------- 开机自启 ----------
# 1=开机自启, 0=手动启动
autostart=1

# ---------- 分应用代理 ----------
app_proxy_enable=0
app_proxy_mode="whitelist"
auto_proxy_apps_enable=0
proxy_apps_list=""
bypass_apps_list=""
