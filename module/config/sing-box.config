# ============================================================
# FluxNet 模块配置
# 修改后重启服务生效
# ============================================================

# ---------- 路径 ----------
sing_box_path="/data/adb/fluxnet"

# ---------- 内核渠道 ----------
# delusions6515-pre / delusions6515-stable / ref1nd-pre / ref1nd-stable
# official-stable / official-pre
kernel_channel="delusions6515-pre"
kernel_abi="arm64-v8a"

# ---------- 代理模式 ----------
# tun / tproxy / redirect / ebpf
proxy_mode="tproxy"

# ---------- Tun 模式选项 ----------
# tun stack: system / gvisor / mixed
# tun auto_redirect: 0=关闭, 1=开启
# tun_forward: 0=关闭, 1=开启; 热点共享，开启后通过 FORWARD + ip rules 让热点设备走代理
tun_stack="gvisor"
auto_redirect=1
tun_forward=0

# ---------- ebpf 模式选项 ----------
# ebpf mode: local / shared
ebpf_mode="local"

# ---------- 开机自启 ----------
# 1=开机自启, 0=手动启动
autostart=1

# ---------- 分应用代理 ----------
app_proxy_enable=0
app_proxy_mode="whitelist"
auto_proxy_apps_enable=0
proxy_apps_list=""
bypass_apps_list=""
